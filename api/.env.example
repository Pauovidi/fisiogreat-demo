APP_ENV=demo
TZ=Europe/Madrid

OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
VOICE_AI_ENABLED=true

ELEVEN_API_KEY=your-elevenlabs-api-key
# Use the real ElevenLabs voice_id, not the visible voice name.
ELEVEN_VOICE_ID=your-elevenlabs-voice-id
ELEVEN_MODEL_ID=eleven_multilingual_v2

PUBLIC_BASE_URL=https://your-public-backend.example.com

CONVERSATIONRELAY_TTS_PROVIDER=ElevenLabs
CONVERSATIONRELAY_TTS_PROVIDER_FALLBACK=Google
# Use the real ElevenLabs voice_id, not the visible voice name.
CONVERSATIONRELAY_TTS_VOICE=your-elevenlabs-voice-id
CONVERSATIONRELAY_TTS_LANGUAGE=es-ES
CONVERSATIONRELAY_TRANSCRIPTION_LANGUAGE=es-ES
CONVERSATIONRELAY_TRANSCRIPTION_PROVIDER=Google
CONVERSATIONRELAY_SPEECH_MODEL=telephony
CONVERSATIONRELAY_INTERRUPTIBLE=speech
CONVERSATIONRELAY_REPORT_INPUT_DURING_AGENT_SPEECH=none
CONVERSATIONRELAY_DTMF_DETECTION=true

GOOGLE_CREDENTIALS_JSON_BASE64=base64-encoded-google-service-account-json
GOOGLE_CALENDAR_ID=your-google-calendar-id

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname
CORS_ORIGINS=http://localhost:3000
SALON_HOURS=Lunes a viernes 09:00-19:00 | Sabado 09:00-14:00 | Domingo cerrado
SALON_LOCATION=Calle Mayor 25, Madrid
SALON_SERVICES=corte, corte y lavado, color, color raiz, mechas y peinado
SALON_PRICE_GUIDANCE=Depende del servicio y del largo del pelo.
SALON_PHONE=+34XXXXXXXXX
